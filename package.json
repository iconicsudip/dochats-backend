{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migration:generate": "prisma migrate dev",
    "migration:run": "prisma migrate deploy",
    "seed": "prisma db seed",
    "db:clear": "ts-node scripts/clearDatabase.ts",
    "pm2:start": "npm run build && npm run migration:run && pm2 start ecosystem.config.js",
    "pm2:start:prod": "npm run build && npx prisma generate && npm run migration:run && pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop dochats-server",
    "pm2:restart": "npm run build && npm run migration:run && pm2 restart dochats-server",
    "pm2:delete": "pm2 delete dochats-server",
    "pm2:logs": "pm2 logs dochats-server"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1045.0",
    "@prisma/client": "^6.19.2",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "open-graph-scraper": "^6.11.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "nodemon": "^3.1.7",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
