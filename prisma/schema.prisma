// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String  @id @default(cuid())
  username           String  @unique
  password           String  @db.Text
  name               String?
  logoUrl            String? @db.Text
  role               Role    @default(ADMIN)
  isFirstLogin       Boolean @default(false)
  mustChangePassword Boolean @default(false)
  hasSeenTour        Boolean @default(false)
  subscriptionAmount Int

  planId        String?
  plan          Plan?        @relation(fields: [planId], references: [id])
  billingCycle  BillingCycle @default(MONTHLY)
  subUsersLimit Int?         @default(3)
  linksLimit    Int?         @default(5)

  parentId String?
  parent   User?   @relation("SubUsers", fields: [parentId], references: [id])
  subUsers User[]  @relation("SubUsers")

  links           ShortLink[]          @relation("CreatedLinks")
  assignedLinks   ShortLink[]          @relation("AssignedLinks")
  subscriptions   Subscription[]
  upgradeRequests PlanUpgradeRequest[]
  crmLeads        CrmLead[]            @relation("OwnedLeads")
  bookings        Booking[]            @relation("OwnedBookings")
  automationRules AutomationRule[]     @relation("OwnedRules")
  emailTemplates  EmailTemplate[]      @relation("OwnedEmailTemplates")
  forms           CustomForm[]         @relation("OwnedForms")
  moduleConfig    AdminModuleConfig?   @relation("ModuleConfig")
  notifications   Notification[]

  whatsappConfig      Json?        // { apiKey: string, phoneNumberId: string, businessAccountId: string }
  emailConfig         Json?        // { fromEmail: string, fromName: string }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId], name: "idx_user_parentId")
  @@index([role], name: "idx_user_role")
  @@index([planId], name: "idx_user_planId")
}

model Plan {
  id                 String               @id @default(cuid())
  name               String               @unique
  monthlyPrice       Int                  @default(0)
  yearlyPrice        Int                  @default(0)
  order              Int                  @default(0)
  subUsersLimit      Int                  @default(3)
  linksLimit         Int                  @default(5)
  leadCaptureEnabled Boolean              @default(false)
  isPublic           Boolean              @default(true)
  description        String?
  enabledModules     Json?                // predefined Module[] for the plan
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  upgradeRequests    PlanUpgradeRequest[]
}

model PlanUpgradeRequest {
  id           String               @id @default(cuid())
  user         User                 @relation(fields: [userId], references: [id])
  userId       String
  plan         Plan?                @relation(fields: [planId], references: [id])
  planId       String?
  billingCycle BillingCycle         @default(MONTHLY)
  status       UpgradeRequestStatus @default(PENDING)
  message      String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUB_USER
}

model ShortLink {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  welcomeMessage    String?        @default("Hello! How can I help you today?")
  whatsappLink      String?
  whatsappThreshold Int            @default(5)
  leadCaptureFormId String?
  leadCaptureDelay  Int            @default(3)
  creator           User           @relation("CreatedLinks", fields: [creatorId], references: [id])
  creatorId         String
  assignedUsers     User[]         @relation("AssignedLinks")
  conversations     Conversation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([creatorId], name: "idx_shortlink_creatorId")
}

model Conversation {
  id            String    @id @default(cuid())
  visitorToken  String // A unique token for the visitor session
  visitorName   String?
  visitorPhone  String?
  link          ShortLink @relation(fields: [linkId], references: [id])
  linkId        String
  messages      Message[]
  waRedirected      Boolean   @default(false)
  noReplyTriggered  Boolean   @default(false)
  lastMessageAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([linkId], name: "idx_conversation_linkId")
  @@index([lastMessageAt], name: "idx_conversation_lastMessageAt")
  @@index([linkId, visitorToken], name: "idx_conversation_linkId_visitorToken")
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  isFromAdmin    Boolean      @default(false)
  isRead         Boolean      @default(false)
  linkPreview    Json? // { title, description, image, url }
  replyToId      String?
  replyTo        Message?     @relation("ReplyTo", fields: [replyToId], references: [id])
  replies        Message[]    @relation("ReplyTo")
  createdAt      DateTime     @default(now())

  @@index([conversationId], name: "idx_message_conversationId")
  @@index([createdAt], name: "idx_message_createdAt")
  @@index([conversationId, isRead, isFromAdmin], name: "idx_message_conversationId_isRead_isFromAdmin")
  @@index([replyToId], name: "idx_message_replyToId")
}

enum MessageType {
  TEXT
  AUDIO
}

model Subscription {
  id        String             @id @default(cuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  startDate DateTime
  endDate   DateTime
  amount    Int
  status    SubscriptionStatus @default(ACTIVE)
  payment   Payment?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId], name: "idx_subscription_userId")
  @@index([status], name: "idx_subscription_status")
  @@index([endDate], name: "idx_subscription_endDate")
}

enum SubscriptionStatus {
  ACTIVE
  OVERDUE
  EXPIRED
}

model Payment {
  id                String        @id @default(cuid())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  subscriptionId    String        @unique
  amount            Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status], name: "idx_payment_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ─────────────────────────────────────────────
// MODULE: CRM
// ─────────────────────────────────────────────

model CrmLead {
  id         String        @id @default(cuid())
  owner      User          @relation("OwnedLeads", fields: [ownerId], references: [id])
  ownerId    String
  name       String
  phone      String
  email      String?
  industry   String?
  source     String?       // 'AI Chat' | 'Smart Link' | 'Manual' | 'WhatsApp'
  status     CrmLeadStatus @default(NEW)
  value      Int           @default(0)
  notes      String?       @db.Text
  assignedTo String?
  bookings   Booking[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ─────────────────────────────────────────────
// MODULE: BOOKINGS
// ─────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  owner       User          @relation("OwnedBookings", fields: [ownerId], references: [id])
  ownerId     String
  lead        CrmLead?      @relation(fields: [leadId], references: [id])
  leadId      String?
  clientName  String
  phone       String
  email       String?       // Explicit email for manual bookings/automation mapping
  service     String
  industry    String?
  date        DateTime
  duration    Int           @default(60) // minutes
  status      BookingStatus @default(PENDING)
  source      String?       // 'AI Chat' | 'Smart Link' | 'Manual'
  notes       String?       @db.Text
  assignedTo  String?
  formData    Json?         // industry-specific dynamic form data
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
  @@index([date])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// MODULE: AUTOMATION
// ─────────────────────────────────────────────

model AutomationRule {
  id        String      @id @default(cuid())
  owner     User        @relation("OwnedRules", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  trigger   String      // TriggerType key
  actions   Json        // ActionType[] (Legacy)
  flow      Json?       // Tree-based logic flow structure
  config    Json?       // { whatsappTemplate: string, emailSubject: string, etc. }
  delay     Int?        @default(0) // delay in minutes
  enabled   Boolean     @default(true)
  runs      Int         @default(0)
  lastRunAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  logs      AutomationLog[]

  @@index([ownerId])
  @@index([enabled])
}

model AutomationLog {
  id        String         @id @default(cuid())
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId    String
  ownerId   String
  trigger   String
  action    String
  status    LogStatus      @default(SUCCESS)
  message   String?        @db.Text
  details   Json?          // Data that was processed
  executedAt DateTime      @default(now())

  @@index([ruleId])
  @@index([ownerId])
}

model ScheduledTask {
  id          String   @id @default(cuid())
  ownerId     String
  ruleId      String
  action      String
  data        Json
  executeAt   DateTime
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([executeAt])
  @@index([processed])
}

enum LogStatus {
  SUCCESS
  FAILED
  DELAYED
}

// ─────────────────────────────────────────────
// MODULE ACCESS CONTROL
// ─────────────────────────────────────────────

model AdminModuleConfig {
  id             String   @id @default(cuid())
  admin          User     @relation("ModuleConfig", fields: [adminId], references: [id])
  adminId        String   @unique
  enabledModules Json     // Module[]
  updatedAt      DateTime @updatedAt

  @@index([adminId])
}

// ─────────────────────────────────────────────
// MODULE: DYNAMIC FORMS
// ─────────────────────────────────────────────

model CustomForm {
  id               String         @id @default(cuid())
  title            String
  description      String?        @db.Text
  fields           Json           // Array of form fields { label, type, required, options }
  integrationConfig Json?         // { syncToBookings: boolean, fieldMapping: object, automationId: string }
  owner            User           @relation("OwnedForms", fields: [ownerId], references: [id])
  ownerId          String
  isActive         Boolean        @default(true)
  responses        FormResponse[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
}

model FormResponse {
  id        String     @id @default(cuid())
  form      CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  data      Json       // Submitted form data
  metadata  Json?      // IP, User Agent, etc.
  createdAt DateTime   @default(now())

  @@index([formId])
}
model Notification {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId], name: "idx_notification_ownerId")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  owner     User     @relation("OwnedEmailTemplates", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  subject   String
  content   String   @db.Text    // Final HTML for sending
  design    Json?                // Editor state (blocks, colors, etc)
  sesSynced Boolean  @default(false)
  sesTemplateName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([sesSynced])
}

