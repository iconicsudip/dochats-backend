// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String  @id @default(cuid())
  username           String  @unique
  password           String  @db.Text
  name               String?
  logoUrl            String? @db.Text
  role               Role    @default(ADMIN)
  isFirstLogin       Boolean @default(false)
  mustChangePassword Boolean @default(false)
  hasSeenTour        Boolean @default(false)
  subscriptionAmount Int

  planId        String?
  plan          Plan?        @relation(fields: [planId], references: [id])
  billingCycle  BillingCycle @default(MONTHLY)
  subUsersLimit Int?         @default(3)
  linksLimit    Int?         @default(5)

  parentId String?
  parent   User?   @relation("SubUsers", fields: [parentId], references: [id])
  subUsers User[]  @relation("SubUsers")

  links           ShortLink[]          @relation("CreatedLinks")
  assignedLinks   ShortLink[]          @relation("AssignedLinks")
  subscriptions   Subscription[]
  upgradeRequests PlanUpgradeRequest[]
  crmLeads        CrmLead[]            @relation("OwnedLeads")
  bookings        Booking[]            @relation("OwnedBookings")
  automationRules AutomationRule[]     @relation("OwnedRules")
  emailTemplates  EmailTemplate[]      @relation("OwnedEmailTemplates")
  forms           CustomForm[]         @relation("OwnedForms")
  moduleConfig    AdminModuleConfig?   @relation("ModuleConfig")
  notifications   Notification[]
  ownedChatGroups ChatGroup[]          @relation("OwnedChatGroups")
  chatGroupMemberships ChatGroupMember[]
  groupMessages   GroupMessage[]       @relation("SentGroupMessages")
  createdCampaigns     BroadcastCampaign[]  @relation("CreatedCampaigns")
  assignedConversations Conversation[]      @relation("AssignedConversations")

  whatsappConfig      Json?        // { apiKey: string, phoneNumberId: string, businessAccountId: string }
  emailConfig         Json?        // { fromEmail: string, fromName: string }
  calendarConfig      Json?        // { googleCalendar: { enabled, account, syncToken }, outlook: { enabled, account }, apple: { enabled }, autoGenerateMeet: boolean }
  resetToken          String?      @db.Text
  resetTokenExpiry    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId], name: "idx_user_parentId")
  @@index([role], name: "idx_user_role")
  @@index([planId], name: "idx_user_planId")
}

model Plan {
  id                 String               @id @default(cuid())
  name               String               @unique
  monthlyPrice       Int                  @default(0)
  yearlyPrice        Int                  @default(0)
  order              Int                  @default(0)
  subUsersLimit      Int                  @default(3)
  linksLimit         Int                  @default(5)
  leadCaptureEnabled Boolean              @default(false)
  isPublic           Boolean              @default(true)
  description        String?
  enabledModules     Json?                // predefined Module[] for the plan
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  users              User[]
  upgradeRequests    PlanUpgradeRequest[]
}

model PlanUpgradeRequest {
  id           String               @id @default(cuid())
  user         User                 @relation(fields: [userId], references: [id])
  userId       String
  plan         Plan?                @relation(fields: [planId], references: [id])
  planId       String?
  billingCycle BillingCycle         @default(MONTHLY)
  status       UpgradeRequestStatus @default(PENDING)
  message      String?              @db.Text
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([userId])
  @@index([status])
}

enum UpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUB_USER
}

model ShortLink {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  welcomeMessage    String?        @default("Hello! How can I help you today?")
  whatsappLink      String?
  whatsappThreshold Int            @default(5)
  leadCaptureFormId String?
  leadCaptureDelay  Int            @default(3)
  whatsappOnFormSubmit Boolean     @default(false)
  chatBackgroundImage String?
  menuOptions       Json?          @default("[]")
  assignmentRule    String         @default("MANUAL")
  creator           User           @relation("CreatedLinks", fields: [creatorId], references: [id])
  creatorId         String
  assignedUsers     User[]         @relation("AssignedLinks")
  conversations     Conversation[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([creatorId], name: "idx_shortlink_creatorId")
  @@index([slug], name: "idx_shortlink_slug")
  @@index([creatorId, createdAt], name: "idx_shortlink_creator_created")
}

model Conversation {
  id            String    @id @default(cuid())
  visitorToken  String // A unique token for the visitor session
  visitorName   String?
  visitorPhone  String?
  visitorEmail  String?
  link          ShortLink @relation(fields: [linkId], references: [id])
  linkId        String
  messages      Message[]
  waRedirected      Boolean   @default(false)
  noReplyTriggered  Boolean   @default(false)
  lastMessageAt     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  assignedUserId    String?
  assignedUser      User?     @relation("AssignedConversations", fields: [assignedUserId], references: [id])
  isPinned          Boolean   @default(false)
  isArchived        Boolean   @default(false)

  @@index([linkId], name: "idx_conversation_linkId")
  @@index([lastMessageAt], name: "idx_conversation_lastMessageAt")
  @@index([linkId, visitorToken], name: "idx_conversation_linkId_visitorToken")
  @@index([visitorToken], name: "idx_conversation_visitorToken")
  @@index([linkId, lastMessageAt], name: "idx_conversation_link_lastMsg")
  @@index([assignedUserId], name: "idx_conversation_assignedUserId")
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  content        String       @db.Text
  type           MessageType  @default(TEXT)
  isFromAdmin    Boolean      @default(false)
  isRead         Boolean      @default(false)
  linkPreview    Json? // { title, description, image, url }
  replyToId      String?
  replyTo        Message?     @relation("ReplyTo", fields: [replyToId], references: [id])
  replies        Message[]    @relation("ReplyTo")
  createdAt      DateTime     @default(now())

  @@index([conversationId], name: "idx_message_conversationId")
  @@index([createdAt], name: "idx_message_createdAt")
  @@index([conversationId, isRead, isFromAdmin], name: "idx_message_conversationId_isRead_isFromAdmin")
  @@index([replyToId], name: "idx_message_replyToId")
  @@index([conversationId, createdAt], name: "idx_message_conv_createdAt")
}

enum MessageType {
  TEXT
  AUDIO
}

model Subscription {
  id        String             @id @default(cuid())
  user      User               @relation(fields: [userId], references: [id])
  userId    String
  startDate DateTime
  endDate   DateTime
  amount    Int
  status    SubscriptionStatus @default(ACTIVE)
  payment   Payment?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId], name: "idx_subscription_userId")
  @@index([status], name: "idx_subscription_status")
  @@index([endDate], name: "idx_subscription_endDate")
  @@index([userId, status, endDate], name: "idx_sub_user_status_end")
}

enum SubscriptionStatus {
  ACTIVE
  OVERDUE
  EXPIRED
}

model Payment {
  id                String        @id @default(cuid())
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id])
  subscriptionId    String        @unique
  amount            Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status], name: "idx_payment_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ─────────────────────────────────────────────
// MODULE: CRM
// ─────────────────────────────────────────────

model CrmLead {
  id         String        @id @default(cuid())
  owner      User          @relation("OwnedLeads", fields: [ownerId], references: [id])
  ownerId    String
  name       String
  phone      String
  email      String?
  industry   String?
  source     String?       // 'AI Chat' | 'Smart Link' | 'Manual' | 'WhatsApp'
  status     CrmLeadStatus @default(NEW)
  value      Int           @default(0)
  notes      String?       @db.Text
  assignedTo String?

  jobTitle          String?
  company           String?
  city              String?
  address           String?
  lifecycleStage    String?       @default("Lead") // Lead, MQL, SQL, Customer, Evangelist
  favoriteTopics    Json?         // e.g. ["AI Chatbots", "WhatsApp"]
  preferredChannels Json?         // e.g. ["Email", "WhatsApp", "Phone"]
  communicationSubs Json?         // { newsletter: boolean, marketing: boolean }
  aiSummary         String?       @db.Text
  aiInsights        Json?         // { sentiment, suggestedFollowUps: string[], conversationSummary: string }
  associations      Json?         // { companies: [], deals: [], tickets: [], relationshipLabel: "Decision Maker" }
  customFields      Json?         // { key: value }
  activityTimeline  Json?         // Array of { id, type: 'NOTE'|'EMAIL'|'CALL'|'MEETING'|'TASK', title, description, date, status, dueDate }

  bookings   Booking[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([ownerId, createdAt], name: "idx_crmlead_owner_createdAt")
  @@index([ownerId, status, createdAt], name: "idx_crmlead_owner_status_createdAt")
  @@index([phone], name: "idx_crmlead_phone")
  @@index([email], name: "idx_crmlead_email")
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ─────────────────────────────────────────────
// MODULE: BOOKINGS
// ─────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  owner       User          @relation("OwnedBookings", fields: [ownerId], references: [id])
  ownerId     String
  lead        CrmLead?      @relation(fields: [leadId], references: [id])
  leadId      String?
  clientName  String
  phone       String
  email       String?       // Explicit email for manual bookings/automation mapping
  service     String
  industry    String?
  date        DateTime
  duration    Int           @default(60) // minutes
  status      BookingStatus @default(PENDING)
  source      String?       // 'AI Chat' | 'Smart Link' | 'Manual'
  notes       String?       @db.Text
  assignedTo  String?
  formData           Json?         // industry-specific dynamic form data
  calendarEventId    String?
  googleCalendarUrl  String?       @db.Text
  outlookCalendarUrl String?       @db.Text
  meetingUrl         String?       @db.Text
  externalSynced     Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([ownerId])
  @@index([date])
  @@index([status])
  @@index([leadId], name: "idx_booking_leadId")
  @@index([ownerId, date], name: "idx_booking_owner_date")
  @@index([ownerId, status, date], name: "idx_booking_owner_status_date")
  @@index([calendarEventId], name: "idx_booking_calendarEventId")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// MODULE: AUTOMATION
// ─────────────────────────────────────────────

model AutomationRule {
  id        String      @id @default(cuid())
  owner     User        @relation("OwnedRules", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  trigger   String      // TriggerType key
  actions   Json        // ActionType[] (Legacy)
  flow      Json?       // Tree-based logic flow structure
  config    Json?       // { whatsappTemplate: string, emailSubject: string, etc. }
  delay     Int?        @default(0) // delay in minutes
  enabled   Boolean     @default(true)
  runs      Int         @default(0)
  lastRunAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  logs      AutomationLog[]

  @@index([ownerId])
  @@index([enabled])
  @@index([ownerId, enabled], name: "idx_autorule_owner_enabled")
}

model AutomationLog {
  id        String         @id @default(cuid())
  rule      AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId    String
  ownerId   String
  trigger   String
  action    String
  status    LogStatus      @default(SUCCESS)
  message   String?        @db.Text
  details   Json?          // Data that was processed
  executedAt DateTime      @default(now())

  @@index([ruleId])
  @@index([ownerId])
}

// ─────────────────────────────────────────────
// MODULE: CHAT GROUPS (internal team chat)
// ─────────────────────────────────────────────

model ChatGroup {
  id            String            @id @default(cuid())
  name          String
  avatarUrl     String?
  owner         User              @relation("OwnedChatGroups", fields: [ownerId], references: [id])
  ownerId       String
  members       ChatGroupMember[]
  messages      GroupMessage[]
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([ownerId])
  @@index([ownerId, lastMessageAt])
}

model ChatGroupMember {
  id       String    @id @default(cuid())
  group    ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User      @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupMessage {
  id          String        @id @default(cuid())
  group       ChatGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  sender      User          @relation("SentGroupMessages", fields: [senderId], references: [id])
  senderId    String
  content     String        @db.Text
  type        MessageType   @default(TEXT)
  systemLink  Json?         // { type, id, label, path }
  linkPreview Json?
  replyToId   String?
  replyTo     GroupMessage? @relation("GroupReplyTo", fields: [replyToId], references: [id])
  replies     GroupMessage[] @relation("GroupReplyTo")
  createdAt   DateTime      @default(now())

  @@index([groupId])
  @@index([groupId, createdAt])
  @@index([senderId])
}

model ScheduledTask {
  id          String   @id @default(cuid())
  ownerId     String
  ruleId      String
  action      String
  data        Json
  executeAt   DateTime
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([executeAt])
  @@index([processed])
}

enum LogStatus {
  SUCCESS
  FAILED
  DELAYED
}

// ─────────────────────────────────────────────
// MODULE ACCESS CONTROL
// ─────────────────────────────────────────────

model AdminModuleConfig {
  id             String   @id @default(cuid())
  admin          User     @relation("ModuleConfig", fields: [adminId], references: [id])
  adminId        String   @unique
  enabledModules Json     // Module[]
  updatedAt      DateTime @updatedAt

  @@index([adminId])
}

// ─────────────────────────────────────────────
// MODULE: DYNAMIC FORMS
// ─────────────────────────────────────────────

model CustomForm {
  id               String         @id @default(cuid())
  title            String
  description      String?        @db.Text
  fields           Json           // Array of form fields { label, type, required, options }
  integrationConfig Json?         // { syncToBookings: boolean, fieldMapping: object, automationId: string }
  design           Json?          // { primaryColor: string, backgroundColor: string, textColor: string }
  owner            User           @relation("OwnedForms", fields: [ownerId], references: [id])
  ownerId          String
  isActive         Boolean        @default(true)
  addToCrm         Boolean        @default(false)
  responses        FormResponse[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ownerId])
  @@index([ownerId, isActive, createdAt], name: "idx_customform_owner_active_created")
}

model FormResponse {
  id        String     @id @default(cuid())
  form      CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    String
  data      Json       // Submitted form data
  metadata  Json?      // IP, User Agent, etc.
  createdAt DateTime   @default(now())

  @@index([formId])
  @@index([formId, createdAt], name: "idx_formresponse_form_created")
}
model Notification {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, ALERT
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId], name: "idx_notification_ownerId")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  owner     User     @relation("OwnedEmailTemplates", fields: [ownerId], references: [id])
  ownerId   String
  name      String
  subject   String
  content   String   @db.Text    // Final HTML for sending
  design    Json?                // Editor state (blocks, colors, etc)
  sesSynced Boolean  @default(false)
  sesTemplateName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([sesSynced])
}

model BroadcastCampaign {
  id           String           @id @default(cuid())
  name         String
  targetFilter Json             // filters like tags, leadStatus, country
  content      String           @db.Text
  mediaUrl     String?          @db.Text
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       CampaignStatus   @default(PENDING)
  creator      User             @relation("CreatedCampaigns", fields: [creatorId], references: [id])
  creatorId    String
  recipientsLog Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([creatorId])
  @@index([status])
}

enum CampaignStatus {
  PENDING
  SENT
  FAILED
}

